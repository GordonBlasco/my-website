---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import FormattedDate from "../../components/layouts/FormattedDate.astro";
import PublicationScatter from "../../components/charts/PublicationScatter.astro";
import PagesReadArea from "../../components/charts/PagesReadArea.astro";
import { monthLabel } from "../../components/charts/scale";

const lastRead = (finishedDates: Date[]) =>
  finishedDates.length > 0
    ? new Date(Math.max(...finishedDates.map((date) => date.valueOf())))
    : undefined;

const sortDate = (post: CollectionEntry<"library">) =>
  lastRead(post.data.finishedDates)?.valueOf() ?? post.data.pubDate?.valueOf() ?? 0;

const posts = (
  await getCollection("library", ({ data }) => !import.meta.env.PROD || !data.draft)
).sort((a, b) => sortDate(b) - sortDate(a));

/*
 * `publicationDate` is bibliographic text, so a year is parsed out of it rather
 * than assumed; anything without one is left off the plot instead of landing on
 * a made-up point.
 */
const plotBooks = posts
  .map((post) => {
    const year = Number(post.data.publicationDate.match(/\d{4}/)?.[0]);
    return {
      title: post.data.title,
      href: `/library/${post.id}/`,
      authors: post.data.authors,
      category: post.data.category,
      pages: post.data.pages,
      finished: post.data.finishedDates,
      year,
    };
  })
  .filter((book) => Number.isFinite(book.year));

/*
 * One table for the whole view. Both plots are readings of the same rows, so a
 * table under each would repeat itself; this is the text equivalent of both.
 */
const tableRows = [...plotBooks].sort(
  (a, b) => a.year - b.year || a.title.localeCompare(b.title),
);
---

<PageLayout
  title="Library"
  description="Books I've read, with notes and reviews."
  intro={"Some scattered notes and reviews on books."}
>
  <div class="library-toolbar" hidden={posts.length === 0}>
    <span>View</span>
    <div class="view-toggle" role="group" aria-label="Library view">
      <button type="button" data-view="grid" aria-pressed="true">Covers</button>
      <button type="button" data-view="list" aria-pressed="false">List</button>
      <button type="button" data-view="plots" aria-pressed="false">Plots</button>
    </div>
  </div>

  {
    posts.length > 0 ? (
      <ol class="library-posts" data-view="grid">
        {posts.map((post) => (
          <li>
            <a class="book-cover" href={`/library/${post.id}/`} tabindex="-1" aria-hidden="true">
              <Image
                src={post.data.cover}
                alt=""
                widths={[180, 280, 420]}
                sizes="(max-width: 520px) 42vw, 200px"
              />
            </a>
            <div class="book-details">
              <a class="book-title" href={`/library/${post.id}/`}>{post.data.title}</a>
              {lastRead(post.data.finishedDates) && (
                <span class="last-read">
                  <span class="last-read-label">Last read </span>
                  <FormattedDate date={lastRead(post.data.finishedDates)!} />
                </span>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-library">No books here yet.</p>
    )
  }

  {plotBooks.length > 0 && (
    <div class="library-plots" hidden>
      <PublicationScatter books={plotBooks} />
      <PagesReadArea books={plotBooks} />

      <details class="plot-table">
        <summary>Data table</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Published</th>
                <th scope="col">Title</th>
                <th scope="col">Category</th>
                <th scope="col">Pages</th>
                <th scope="col">Month read</th>
              </tr>
            </thead>
            <tbody>
              {tableRows.map((book) => (
                <tr>
                  <td class="num">{book.year}</td>
                  <td><a href={book.href}>{book.title}</a></td>
                  <td class="num">{book.category === "fiction" ? "Fiction" : "Non-fiction"}</td>
                  <td class="num">{book.pages ?? "—"}</td>
                  <td class="num">
                    {book.finished.length > 0
                      ? book.finished.map(monthLabel).join(", ")
                      : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </div>
  )}
</PageLayout>

<script>
  const library = document.querySelector<HTMLOListElement>(".library-posts");
  const plots = document.querySelector<HTMLElement>(".library-plots");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-view]");

  type View = "grid" | "list" | "plots";

  const setView = (view: View) => {
    if (!library) return;
    // Plots replaces the listing rather than sitting beside it, so the two are
    // swapped wholesale; grid and list stay a restyle of the same list.
    const plotting = view === "plots";
    library.hidden = plotting;
    if (plots) plots.hidden = !plotting;
    if (!plotting) library.dataset.view = view;
    buttons.forEach((button) =>
      button.setAttribute("aria-pressed", String(button.dataset.view === view)),
    );
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => setView(button.dataset.view as View));
  });

  /*
   * Plot tooltips. One pass over every `.plot-frame` on the page, so the two
   * charts share this rather than each shipping its own copy.
   */
  document.querySelectorAll<HTMLElement>(".plot-frame").forEach((frame) => {
    const tip = frame.querySelector<HTMLElement>(".plot-tip");
    const label = frame.querySelector<HTMLElement>(".tip-label");
    const meta = frame.querySelector<HTMLElement>(".tip-meta");
    if (!tip || !label || !meta) return;

    const hide = () => {
      tip.hidden = true;
    };

    // Either a book's `<a>` on the scatters or a month's `<g>` on the area chart.
    const show = (point: SVGElement) => {
      // Book titles are content, so they go in as text, never as markup.
      label.textContent = point.dataset.label ?? "";
      meta.textContent = point.dataset.meta ?? "";
      tip.hidden = false;

      const dot = point.querySelector(".dot") as SVGCircleElement | null;
      if (!dot) return;
      const mark = dot.getBoundingClientRect();
      const box = frame.getBoundingClientRect();

      // Centred over the mark, then pulled back inside the frame at the edges.
      const half = tip.offsetWidth / 2;
      const centre = mark.left + mark.width / 2 - box.left;
      tip.style.setProperty(
        "--tip-x",
        `${Math.min(Math.max(centre, half + 4), box.width - half - 4)}px`,
      );
      tip.style.setProperty("--tip-y", `${mark.top - box.top - 10}px`);
    };

    frame.querySelectorAll<SVGElement>(".pt").forEach((point) => {
      point.addEventListener("pointerenter", () => show(point));
      point.addEventListener("pointerleave", hide);
      point.addEventListener("focus", () => show(point));
      point.addEventListener("blur", hide);
    });

    frame.addEventListener("pointerleave", hide);
  });
</script>

<style>
  /*
   * The view switch is a control, not prose, so it sits closer under the intro
   * than the standard content gap. Spacing only — the column width itself stays
   * with --content-width in tokens.css.
   */
  :global(main .page-heading) {
    margin-bottom: 1rem;
  }

  .library-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 1rem;
    gap: 0.65rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
  }

  .view-toggle { display: flex; }
  .view-toggle button {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--background);
    font: inherit;
    cursor: pointer;
  }
  .view-toggle button + button { border-left: 0; }
  .view-toggle button[aria-pressed="true"] { color: var(--text); background: var(--surface); }
  .view-toggle button:focus-visible { position: relative; outline: 2px solid var(--accent); outline-offset: 2px; }

  .library-posts { margin: 0; padding: 0; list-style: none; }

  /*
   * The track minimum is set so four covers fit the shared --content-width
   * with room to spare; the tracks then stretch to fill it. Raising it much
   * past 9rem drops the row to three at 680px.
   */
  .library-posts[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    align-items: start;
    gap: 2.25rem 1.5rem;
  }
  .library-posts[data-view="grid"] .book-cover {
    display: block;
    aspect-ratio: 2 / 3;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }
  .library-posts[data-view="grid"] .book-cover img { width: 100%; height: 100%; object-fit: cover; }
  /*
   * Block, not inline: an inline anchor still inherits the parent's line-height
   * for its strut, so titles wrapping to two or three lines in a cover column
   * would space out at the body's 1.65 regardless of the value set here.
   */
  .book-title {
    display: block;
    color: var(--link);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }
  .book-title:hover, .book-title:focus-visible { text-decoration: underline; text-decoration-color: var(--link-underline); }
  .book-details .last-read {
    display: block;
    margin-top: 0.3rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    line-height: 1.35;
  }

  /* List view uses the same ledger rows as `.post-list`. */
  .library-posts[data-view="list"] li {
    display: grid;
    grid-template-columns: var(--ledger-date-width) minmax(0, 1fr);
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    gap: 0 0.875rem;
  }
  .library-posts[data-view="list"] .book-cover { display: none; }
  .library-posts[data-view="list"] .book-details { display: contents; }
  /*
   * Columns are assigned explicitly so a book with no finish date still has
   * its title in the second column, aligned with every other row.
   */
  .library-posts[data-view="list"] .last-read {
    grid-row: 1;
    grid-column: 1;
    display: block;
    margin: 0;
    white-space: nowrap;
  }
  .library-posts[data-view="list"] .last-read-label { display: none; }
  .library-posts[data-view="list"] .book-title {
    grid-row: 1;
    grid-column: 2;
    font-size: 1rem;
    font-weight: 400;
  }
  /*
   * `display: grid` above outranks the `hidden` attribute's UA rule, so without
   * this the cover grid stays on screen underneath the plot. It has to come
   * after the view rules it is overriding, not before.
   */
  .library-posts[hidden],
  .library-plots[hidden] { display: none; }

  .empty-library { color: var(--muted); }

  @media (max-width: 520px) {
    .library-posts[data-view="grid"] { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1rem; }
    .library-posts[data-view="list"] li { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
    .library-posts[data-view="list"] .last-read,
    .library-posts[data-view="list"] .book-title { grid-row: auto; grid-column: 1; }
    .library-posts[data-view="list"] .last-read { order: -1; }
  }
</style>
