---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import FormattedDate from "../components/layouts/FormattedDate.astro";
import MattedPhoto from "../components/mdx/MattedPhoto.astro";
import runiPhoto from "../assets/baby_runi.JPEG";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const [blogPosts, libraryPosts] = await Promise.all([
  getCollection("blog", ({ data }) => !import.meta.env.PROD || !data.draft),
  getCollection("library", ({ data }) => !import.meta.env.PROD || !data.draft),
]);

const posts = [
  ...blogPosts.map((post) => ({
    ...post,
    href: `/blog/${post.id}/`,
    date: post.data.pubDate,
  })),
  ...libraryPosts.map((post) => ({
    ...post,
    href: `/library/${post.id}/`,
    date: post.data.pubDate,
  })),
]
  .filter((post): post is typeof post & { date: Date } => post.date !== undefined)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <main>
      <section class="intro">
        <div class="intro-copy">
          <h2>Hi, I'm Gordon and I like to program.</h2>
          <p class="lede">
          I am an environmental scientist turned data engineer.
          <br><br>
          This site is more inspired by indie web principles and is not a 
          professional website or portfolio. I will post more about my hobbies
          and less about my profession. Some of that may sneak in though.  
          </p>
        </div>
        <MattedPhoto src={runiPhoto} alt="Runi as a puppy" caption="Baby Runi" />
      </section>

      <section aria-labelledby="recent-posts">
        <div class="section-heading">
          <h2 id="recent-posts">Recent posts</h2>
          <a href="/blog">All posts</a>
        </div>
        <ol class="post-list">
          {
            posts.map((post) => (
              <li>
                <FormattedDate date={post.date} />
                <a href={post.href}>{post.data.title}</a>
              </li>
            ))
          }
        </ol>
      </section>
    </main>
</SiteLayout>
