---
import type { CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import FormattedDate from "../components/layouts/FormattedDate.astro";
import { SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";

type BlogData = CollectionEntry<"blog">["data"];
type LibraryData = CollectionEntry<"library">["data"];
type Props = BlogData | LibraryData;

const { title, pubDate, updatedDate } = Astro.props;
const cover = "cover" in Astro.props ? Astro.props.cover : undefined;
const publicationDate = "publicationDate" in Astro.props ? Astro.props.publicationDate : undefined;
const authors = "authors" in Astro.props ? Astro.props.authors : undefined;
const finishedDates = "finishedDates" in Astro.props ? Astro.props.finishedDates : undefined;
const lastRead = finishedDates && finishedDates.length > 0
  ? new Date(Math.max(...finishedDates.map((date) => date.valueOf())))
  : undefined;
---

<SiteLayout title={title} description={SITE_DESCRIPTION}>
  <main class="article-main">
    <article class="prose">
      <header class="article-title">
        <h1>{title}</h1>
        <hr />
        {pubDate && <div class="article-date"><FormattedDate date={pubDate} /></div>}
        {
          authors && publicationDate && (
            <div class="publication-date">
              {authors.join(" and ")}
            </div>
          )
        }
        {
          lastRead && (
            <div class="last-read-on">
              Last read on <FormattedDate date={lastRead} />
            </div>
          )
        }
        {
          updatedDate && (
            <div class="last-updated-on">
              Last updated on <FormattedDate date={updatedDate} />
            </div>
          )
        }
      </header>
      {
        cover && (
          <Image
            class="article-cover"
            src={cover}
            alt={`Cover of ${title}`}
            widths={[240, 360, 480]}
            sizes="(max-width: 600px) 180px, 240px"
          />
        )
      }
      <slot />
    </article>
  </main>
</SiteLayout>
